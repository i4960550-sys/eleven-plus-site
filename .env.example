# Copy this file to .env for local dev (vite loads it automatically),
# and set the same variables in your Vercel project's Settings > Environment Variables.

# From https://dashboard.stripe.com/apikeys — use the "Secret key".
# Starts with sk_test_... while testing, sk_live_... when you go live.
STRIPE_SECRET_KEY=

# From the webhook you create in the Stripe dashboard (see README step 5).
# Starts with whsec_...
STRIPE_WEBHOOK_SECRET=

# Your live site URL once deployed, e.g. https://elevenplus-slough.co.uk
# Used to build Stripe's success/cancel redirect links. Safe to leave blank
# locally — the app falls back to the current host automatically.
SITE_URL=

# From https://resend.com/api-keys — used to send the download-link email
# after a successful payment (see api/webhook.js).
RESEND_API_KEY=

# Optional. Who the delivery email appears to come from. Until you verify
# your own domain in Resend (https://resend.com/domains), leave this blank
# and it'll fall back to a Resend test address — fine for trying the flow,
# but swap it in before going live so the email doesn't look like spam.
# Format: "ElevenPlus Scholars <papers@yourdomain.co.uk>"
FROM_EMAIL=
